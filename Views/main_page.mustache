<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewpoint" content=width-device-width, initial-scale="1.0">
    <title>Course Planner</title>
     
    <style>

    body{
        font-family : Arial;
        background-color : white;
        display:flex;
        min-height:100vh;
    }

    .sidebar{
        width : 200px;
        background-color :black;
        color : white;
        position: sticky;
        top: 0;
        height:100vh;
    }
    .sidebar-title {
        background-color: #7a003c;
        color: white;
        padding: 18px 16px;
        font-size: 1rem;
        font-weight: bold;
        line-height: 1.3;
    }

    .sidebar nav {
        padding: 12px 0;
        flex : 1;
    }

    .sidebar nav a {
        display:block;
        padding: 12px 18px;
        color: white;
        font-size:0.9rem;
    }
    .toolbar{
        background-color: white;
        border: 1px solid white;
        border-radius: 6px;
        padding: 12px 16px;
        margin-bottom: 20px;
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px;
    }
    .toolbar label{
        font-size:0.83rem;
        font-weight: bold;
        color: grey;
    }
    .toolbar select{
        padding: 6px 10px;
        border: 1px solid lightgrey;
        border-radius:4px;
        font-size: 0.83rem;
    }
    .toolbar button{
        background-color:#7a003c;
        color:white;
        border:none;
        padding:7px 14px;
        border-radius: 4px;
        cursor: pointer;
        font-size:0.83rem;

    }

    table{
        width: 100%;
        border-collapse: collapse;
        background-color: white;
        border-radius: 6px;
        overflow: hidden;
        box-shadow: 0 1px 6px black;
    }

    table th{
        background-color: #7a003c;
        color: white;
        padding: 11px 13px;
        text-align: left;
        font-size: 0.8rem;
        text-transform: uppercase;
        letter-spacing: 0.04em;
        text-align: center
    }

    table td {
        padding: 10px 13px;
        border-bottom: 1px solid white;
        font-size: 0.88rem;
        color: grey;
        text-align: center
    }


    </style>
</head>

<body>
<aside class="sidebar">
    <div class = "sidebar-title">Student<br>Course Planner</div>
    <nav>
        <a href = "/">Dashbord</a>
        <a href ="/add">+Add course</a>
    </nav>
</aside>





<div class="main">
   <h1>Student Course Planner</h1>
    {{#errors.length}}
    <div class="error-box">
        <p>please fix the following errors:</P>
        <ul>
            {{#errors}}
            <li>{{.}}</li>
            {{/errors}}
        </ul>
    </div>
    {{/errors.length}}





{{#showAddForm}}
        <div class="form-container">
            <h3>Register New Course</h3>
            <form action="/addCourse" method="POST">
                <label for="code">Program Code</label>
                <input type="text" name="code">
                <label for = "name">program Name</label>
                <input type="text" name="name">
                <label for= "credit">Enter the credit</label>
                <input type="text" name="credit">
                <label>Availability</label>
                <select name="availability">
                    <option value="1">Available (Yes)</option>
                    <option value="0">Unavailable (No)</option>
                </select>
                <label>Format</label>
                <select name="format">
                    <option value="Online">Online</option>
                    <option value="In-person">In-person</option>
                </select>
                <label for= "type">Enter the course_lv(type)</label>
                <input type="text" name="type">
                <label for= "description">Enter the course desciption</label>
                <input type="text" name="description">
                <button type="submit">Save Course</button>
            </form>
        </div>
{{/showAddForm}}

{{#detailCourse}}
    <div class = "detail-view">
        <h2>{{course_code}}-{{course_name}}</h2>
        <p><strong>Type (level):</strong>{{course_type}}</p>
        <p><strong>Credit:</strong>{{credit}}</p>
        <p><strong>Format:</strong>{{format}}</p>
        <p><strong>Availability:</strong>{{#availability}}Yes{{/availability}} {{^availability}}No {{/availability}}</p>
        <p><strong>Description:</strong>{{description}}</p>
    </div>
{{/detailCourse}}

{{#updatecourse}}
    <div class = "detail-view">
        <h2>{{course_code}}-{{course_name}}</h2>
        <p><strong>Type (level):</strong>{{course_type}}</p>
        <p><strong>Credit:</strong>{{credit}}</p>
        <p><strong>Format:</strong>{{format}}</p>
        <p><strong>Availability:</strong>{{#availability}}Yes{{/availability}} {{^availability}}No {{/availability}}</p>
        <p><strong>Description:</strong>{{description}}</p>
    </div>
 <div class="form-container">
            <h3>Update Course</h3>
            <form action="/update/{{formdata.id}}" method="POST">
                <label for="code">Program Code</label>
                <input type="text" name="code">
                <label for = "name">program Name</label>
                <input type="text" name="name">
                <label for= "credit">Enter the credit</label>
                <input type="text" name="credit">
                <label>Availability</label>
                <select name="availability">
                    <option value="1">Available (Yes)</option>
                    <option value="0">Unavailable (No)</option>
                </select>
                <label>Format</label>
                <select name="format">
                    <option value="Online">Online</option>
                    <option value="In-person">In-person</option>
                </select>
                <label for= "type">Enter the course_lv(type)</label>
                <input type="text" name="type">
                <label for= "description">Enter the course desciption</label>
                <input type="text" name="description">
                <button type="submit">Update Course Course</button>
            </form>
        </div>
{{/updatecourse}}

{{^detailCourse}}
{{^updatecourse}}
    <form class="toolbar" action="/" method ="get">
        <label>Filter by availablitity: </label>
        <select name = "availability">
            <option value = "" >All</option>
            <option value = "1">Available</option>
            <option value = "0">Not Available</option>
        </select>
        <label>Sort by: </label>
        <select name = "sort">
            <option value = "rowid" >N/A</option>
            <option value = "course_code">Course code</option>
            <option value = "course_name">Course Name</option>
            <option value = "course_type">Course Type(level)</option>
        </select>
        <label>Order by </label>
        <select name = "order">
            <option value = "ASC" >A to Z</option>
            <option value = "DESC">Z to A</option>
        </select>  
        <button type ="submit">Apply</button>  
    </form>
    <table>
            <tr>
                <th>Coursecode</th>
                <th>Course name</th>
                <th>Credit</th>
                <th>Availability</th>
                <th>Format</th>
                <th>Type(level)</th>
                <th>Actions</th>
            </tr>
            {{#Courses}}
            <tr>
                <td>{{ course_code }}</td>
                <td>{{ course_name }}</td>
                <td>{{ credit }}</td>
                <td>{{#availability}} Yes{{/availability}} {{^availability}} No {{/availability}}</td>
                <td>{{ format }}</td>
                <td>{{ course_type }}</td>
                <td><a href="/detail/{{ id }}"> D </a><a href="/delete/{{ id }}"> X </a><a href="/updatecourseform/{{ id }}"> U</a>
            </tr>
            {{/Courses}}
        </table>
{{/updatecourse}}
{{/detailCourse}}

</div>
</body>